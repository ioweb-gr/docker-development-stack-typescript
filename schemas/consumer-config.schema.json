{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ioweb-gr/docker-development-stack-typescript/master/schemas/consumer-config.schema.json",
  "title": "IOWEB TypeScript consumer runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_version", "processes", "volume_paths", "persistent_paths", "healthchecks"],
  "properties": {
    "$schema": { "type": "string" },
    "node_version": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "command": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "default": "." },
          "container_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "http_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "https_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "volume_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "persistent_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "healthchecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "process", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "process": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "path": { "type": "string", "pattern": "^/[^\s]*$" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "expected_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "default": [200] }
        }
      }
    }
  }
}
